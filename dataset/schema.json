{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["image_id","bounding_box","dom_xpath","defect_type","severity","injection_method","mos_score"],
    "properties": {
      "image_id": {"type": "string", "pattern": "^ui_[0-9]{4}$"},
      "bounding_box": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
      "dom_xpath": {"type": "string"},
      "defect_type": {"enum": ["css_occlusion","spatial_misalignment","contrast_violation","text_overflow","missing_asset"]},
      "severity": {"enum": ["critical","major","minor"]},
      "injection_method": {"enum": ["inline","external"]},
      "repair_suggestion": {"type": "string"},
      "mos_score": {"type": "integer", "minimum": 0, "maximum": 100},
      "is_natural_defect": {"type": "boolean"}
    }
  }
}
